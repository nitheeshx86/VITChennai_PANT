  "conventions": {
    "rotation": "eye_rotation_L/R (and _quat, _matrix): rotation of the eye's line of sight from straight ahead (forward_world), world frame, XYZ Euler, radians, torsion-free (Listing's law). eye_rotation_matrix @ forward_world = gaze_direction_world, which passes through fixation_target_world",
    "globe_rotation": "globe_rotation_L/R: rigid rotation of the eyeball mesh about its centre from the rest pose (what the renderer applies); differs from eye_rotation by angle kappa",
    "forward_world": [
      -0.0,
      -1.0,
      -0.0
    ],
    "gaze_direction": "visual axis (line to the fovea); both pass through fixation_target_world",
    "optical_axis": "geometric axis of the globe; kappa deg temporal of the visual axis",
    "angle_kappa_deg": 5.0,
    "pixels": "origin top-left corner, x right, y down",
    "pupil_center_2D": "camera_matrix @ pupil_center_3D: pinhole projection of the 3D centre of the pupil disc (no corneal refraction; the refracted image centre is pupil_center_2D_apparent, 0.4-1.3 px away)",
    "eyes": "L/R = avatar's anatomical left/right",
    "H_SIGN": 1.0,
    "V_SIGN": 1.0
  },
