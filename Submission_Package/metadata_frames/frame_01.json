    "angle_kappa_deg": 5.0,
    "pixels": "origin top-left corner, x right, y down",
    "pupil_center_2D": "camera_matrix @ pupil_center_3D: pinhole projection of the 3D centre of the pupil disc (no corneal refraction; the refracted image centre is pupil_center_2D_apparent, 0.4-1.3 px away)",
    "eyes": "L/R = avatar's anatomical left/right",
    "H_SIGN": 1.0,
    "V_SIGN": 1.0
  },
